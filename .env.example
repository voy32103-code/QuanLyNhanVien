NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000
SESSION_HOURS=8
LOGIN_RATE_LIMIT_MAX=8
WRITE_RATE_LIMIT_MAX=120

# Used by npm run backend:init-production to create the first admin account.
# In production, set strong values before running init.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=System Admin

# Paste your Neon/PostgreSQL URL here locally.
# Never commit the real value.
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST/neondb?sslmode=require&channel_binding=require
